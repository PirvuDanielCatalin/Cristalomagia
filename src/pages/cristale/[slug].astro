---
// src/pages/cristale/[slug].astro - Crystal detail page
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrystalActions from '../../components/collections/CrystalActions.astro';

export async function getStaticPaths() {
  const crystals = await getCollection('crystals');
  const sorted = [...crystals].sort((a, b) =>
    a.data.name.localeCompare(b.data.name, 'ro')
  );
  return sorted.map((crystal, index) => ({
    params: { slug: crystal.data.slug },
    props: { crystal, sortedCrystals: sorted, currentIndex: index },
  }));
}

const { crystal, sortedCrystals, currentIndex } = Astro.props;
const { data } = crystal;

const prevCrystal = currentIndex > 0 ? sortedCrystals[currentIndex - 1] : null;
const nextCrystal = currentIndex < sortedCrystals.length - 1 ? sortedCrystals[currentIndex + 1] : null;

const pageTitle = `${data.name} — Crystalica`;
const pageDescription = data.description.length > 155 ? data.description.slice(0, 152) + '...' : data.description;
const canonical = `/cristale/${data.slug}`;
const ogImage = data.image || '/images/og-default.jpg';
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} ogImage={ogImage}>
  <div class="crystal-page">
    <div class="container">
      <!-- Navigation Arrows -->
      <div class="crystal-nav">
        {prevCrystal ? (
          <a href={`/cristale/${prevCrystal.data.slug}`} class="crystal-nav-btn crystal-nav-prev" aria-label="Cristalul anterior">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            <span class="crystal-nav-label">{prevCrystal.data.name}</span>
          </a>
        ) : <span />}
        {nextCrystal ? (
          <a href={`/cristale/${nextCrystal.data.slug}`} class="crystal-nav-btn crystal-nav-next" aria-label="Cristalul următor">
            <span class="crystal-nav-label">{nextCrystal.data.name}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        ) : <span />}
      </div>

      <!-- Breadcrumb (spaced below arrows) -->
      <nav class="breadcrumb crystal-breadcrumb-spacer" aria-label="Breadcrumb">
        <a href="/">Acasă</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/cristale">Cristale</a>
        <span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{data.name}</span>
      </nav>

      <!-- Main layout: 1/3 image left, 2/3 text right -->
      <div class="crystal-main">
        <!-- Left: Image panel -->
        <div class="crystal-image-panel" data-state="none">
          {data.image ? (
            <img src={data.image} alt={data.name} class="crystal-image" loading="eager" />
          ) : (
            <div class="crystal-image-placeholder">
              <svg width="64" height="64" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
          )}
          <CrystalActions slug={data.slug} variant="detail" />
        </div>

        <!-- Right: Content panel -->
        <div class="crystal-text-panel">
          <!-- 1. Title -->
          <h1 class="crystal-title">{data.name}</h1>

          <!-- 2. Other names (subtitle, slightly larger) -->
          {data.otherNames && data.otherNames.length > 0 && (
            <p class="crystal-subtitle">{data.otherNames.join(' / ')}</p>
          )}

          <!-- 3. Description (smaller text) -->
          <p class="crystal-description">{data.description}</p>

          <div class="crystal-sections">
            {/* 4. Proprietăți energetice */}
            {data.properties && data.properties.length > 0 && (
              <section class="crystal-section">
                <h2 class="crystal-section-title">Proprietăți energetice</h2>
                <ul class="crystal-list">
                  {data.properties.map(p => (
                    <li key={p}>{p}</li>
                  ))}
                </ul>
              </section>
            )}

            {/* 5. Chakre, Zodii, Planete, Elemente — fără titlu secțiune */}
            {(data.chakras?.length || data.zodiac?.length || data.planet || data.element?.length) && (
              <section class="crystal-section crystal-section-no-title">
                <div class="crystal-info-grid">
                  {data.chakras && data.chakras.length > 0 && (
                    <div class="crystal-info-block">
                      <dt>Chakre</dt>
                      <dd>
                        <div class="crystal-tags">
                          {data.chakras.map(ch => (
                            <span key={ch} class="crystal-tag">{ch}</span>
                          ))}
                        </div>
                      </dd>
                    </div>
                  )}
                  {data.zodiac && data.zodiac.length > 0 && (
                    <div class="crystal-info-block">
                      <dt>Zodii</dt>
                      <dd>
                        <div class="crystal-tags">
                          {data.zodiac.map(z => (
                            <span key={z} class="crystal-tag">{z}</span>
                          ))}
                        </div>
                      </dd>
                    </div>
                  )}
                  {data.planet && (
                    <div class="crystal-info-block">
                      <dt>Planetă</dt>
                      <dd>{data.planet}</dd>
                    </div>
                  )}
                  {data.element && data.element.length > 0 && (
                    <div class="crystal-info-block">
                      <dt>Elemente</dt>
                      <dd>
                        <div class="crystal-tags">
                          {data.element.map(e => (
                            <span key={e} class="crystal-tag">{e}</span>
                          ))}
                        </div>
                      </dd>
                    </div>
                  )}
                </div>
              </section>
            )}

            {/* 6. Afirmatie cheie — O SINGURĂ DATĂ */}
            {data.affirmation && (
              <section class="crystal-section crystal-affirmation-section">
                <h2 class="crystal-section-title">Afirmație cheie</h2>
                <blockquote class="crystal-affirmation-text">"{data.affirmation}"</blockquote>
              </section>
            )}

            {/* 7. Istoric */}
            {data.history && (
              <section class="crystal-section">
                <h2 class="crystal-section-title">Istoric</h2>
                <div class="crystal-prose">{data.history}</div>
              </section>
            )}

            {/* 8. Utilizari — stil bullet points verde ca Proprietăți energetice */}
            {data.uses && data.uses.length > 0 && (
              <section class="crystal-section">
                <h2 class="crystal-section-title">Utilizări</h2>
                <ul class="crystal-list">
                  {data.uses.map(u => (
                    <li key={u}>{u}</li>
                  ))}
                </ul>
              </section>
            )}

            {/* 9. Îngrijire — stil bullet points verde ca Proprietăți energetice */}
            {data.care && (
              <section class="crystal-section">
                <h2 class="crystal-section-title">Îngrijire</h2>
                <ul class="crystal-list">
                  <li>{data.care}</li>
                </ul>
              </section>
            )}

            {/* 10. Proprietăți fizice — rămâne ca acum */}
            <section class="crystal-section crystal-physical">
              <h2 class="crystal-section-title">Proprietăți fizice</h2>
              <dl class="crystal-dl">
                {data.chemicalFormula && (
                  <div class="crystal-dl-item">
                    <dt>Formula chimică</dt>
                    <dd>{data.chemicalFormula}</dd>
                  </div>
                )}
                {data.color && data.color.length > 0 && (
                  <div class="crystal-dl-item">
                    <dt>Culoare</dt>
                    <dd>{data.color.join(', ')}</dd>
                  </div>
                )}
                {data.hardness && (
                  <div class="crystal-dl-item">
                    <dt>Duritate</dt>
                    <dd>{data.hardness} / 10 Mohs</dd>
                  </div>
                )}
                {data.rarity && (
                  <div class="crystal-dl-item">
                    <dt>Raritate</dt>
                    <dd>{data.rarity}</dd>
                  </div>
                )}
                {data.origin && data.origin.length > 0 && (
                  <div class="crystal-dl-item">
                    <dt>Origină</dt>
                    <dd>{data.origin.join(', ')}</dd>
                  </div>
                )}
                {data.crystalSystem && (
                  <div class="crystal-dl-item">
                    <dt>Sistem cristalin</dt>
                    <dd>{data.crystalSystem}</dd>
                  </div>
                )}
              </dl>
            </section>

            {/* Combinații — sub proprietăți fizice */}
            {data.combinations && data.combinations.length > 0 && (
              <section class="crystal-section">
                <h2 class="crystal-section-title">Combinații recomandate</h2>
                <ul class="crystal-list">
                  {data.combinations.map(c => (
                    <li key={c}>{c}</li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
