---
// Header.astro - Two-navbar layout inspired by Fragrantica
// Primary nav: always visible (logo, Cristale link, search/profile icons)
// Secondary nav: scroll-aware (large search bar, auth controls)
import AuthControls from '../auth/AuthControls.astro';
---

<!-- Primary navbar (thin, always visible) -->
<header class="header-primary" data-header-primary>
  <div class="header-primary-inner">
    <a href="/" class="logo" aria-label="Crystalica - Acasă">
      <span class="logo-icon" aria-hidden="true">
        <svg width="20" height="24" viewBox="0 0 32 38" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
          <path d="M16 2L28 10v16L16 36 4 26V10L16 2Z"/>
          <path d="M16 2v34"/>
          <path d="M4 10l24 8"/>
          <path d="M4 26l24-8"/>
          <path d="M10 18h12"/>
        </svg>
      </span>
      <span class="logo-text">Crystalica</span>
    </a>

    <a href="/cristale" class="nav-link">Cristale</a>

    <div class="header-primary-actions">
      <!-- Search trigger icon -->
      <button type="button" class="icon-btn" data-search-trigger aria-label="Caută cristale">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Profile icon (desktop) -->
      <div class="profile-icon-wrap" data-profile-icon hidden>
        <AuthControls variant="icon" />
      </div>

      <!-- Mobile menu toggle -->
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Deschide meniul">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Secondary navbar (scroll-aware, appears at top) -->
<div class="header-secondary" data-header-secondary hidden>
  <div class="header-secondary-inner">
    <!-- Large search bar -->
    <div class="secondary-search" data-secondary-search>
      <svg class="secondary-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" class="secondary-search-input" placeholder="Caută cristale..." aria-label="Caută cristale" data-secondary-search-input readonly />
    </div>

    <!-- Auth controls (desktop) -->
    <div class="header-secondary-auth" data-secondary-auth>
      <!-- Will be populated by JS -->
    </div>
  </div>
</div>

<!-- Mobile menu -->
<div id="mobile-menu" class="mobile-menu">
  <div class="mobile-menu-inner">
    <a href="/cristale" class="mobile-nav-link">
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 2L22 8v16L16 30L10 24V8L16 2Z"/><path d="M16 8V24"/><path d="M10 16H22"/></svg>
      Cristale
    </a>
    <div class="mobile-menu-auth" data-mobile-auth></div>
  </div>
</div>

<script is:inline>
  // ===== Scroll-aware secondary navbar =====
  (function initScrollNav() {
    const primary = document.querySelector('[data-header-primary]');
    const secondary = document.querySelector('[data-header-secondary]');
    let lastScroll = 0;
    let ticking = false;

    function update() {
      const current = window.scrollY;
      const offset = 60; // Height of primary nav

      if (current < offset) {
        // At top: show secondary
        secondary.hidden = false;
        secondary.classList.add('visible');
      } else if (current > lastScroll) {
        // Scrolling down: hide secondary
        secondary.classList.remove('visible');
        setTimeout(() => { if (!secondary.classList.contains('visible')) secondary.hidden = true; }, 300);
      } else {
        // Scrolling up: show secondary
        secondary.hidden = false;
        secondary.classList.add('visible');
      }
      lastScroll = current;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    });

    // Initial state
    update();
  })();

  // ===== Secondary search click → open overlay =====
  document.querySelector('[data-secondary-search]')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('crystalica:open-search'));
  });
  document.querySelector('[data-search-trigger]')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('crystalica:open-search'));
  });
  document.querySelector('[data-secondary-search-input]')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('crystalica:open-search'));
  });

  // ===== Profile icon behavior =====
  (function initProfileIcon() {
    const wrap = document.querySelector('[data-profile-icon]');
    const btn = document.querySelector('[data-profile-trigger]');
    if (!wrap || !btn) return;

    function updateVisibility() {
      const clerk = window.__crystalicaClerk;
      if (!clerk) return;
      const loggedIn = Boolean(clerk.user);
      wrap.hidden = !loggedIn;
      if (loggedIn) {
        btn.addEventListener('click', () => {
          window.location.href = '/portofoliu';
        });
      }
    }

    window.__crystalicaClerkReady?.then(updateVisibility);
    window.__crystalicaClerk?.addListener(updateVisibility);
  })();

  // ===== Mobile menu =====
  const menuBtn = document.querySelector('.menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!expanded));
      mobileMenu.classList.toggle('open');
    });
    document.addEventListener('click', (e) => {
      if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('open');
      }
    });
  }

  // ===== Populate secondary auth area =====
  function populateSecondaryAuth() {
    const container = document.querySelector('[data-secondary-auth]');
    if (!container) return;
    const clerk = window.__crystalicaClerk;
    if (!clerk) return;

    const user = clerk.user;
    container.innerHTML = '';

    if (user) {
      const name = user.fullName || user.firstName || user.emailAddresses?.[0]?.emailAddress?.split('@')[0] || 'Utilizator';
      const userNameEl = document.createElement('span');
      userNameEl.className = 'secondary-user-name';
      userNameEl.textContent = name;
      userNameEl.addEventListener('click', () => { window.location.href = '/portofoliu'; });
      userNameEl.style.cursor = 'pointer';
      container.appendChild(userNameEl);

      const logoutBtn = document.createElement('button');
      logoutBtn.type = 'button';
      logoutBtn.className = 'secondary-logout-btn';
      logoutBtn.textContent = 'Deconectare';
      logoutBtn.addEventListener('click', () => {
        clerk.signOut().catch(console.error);
      });
      container.appendChild(logoutBtn);
    } else {
      const signInBtn = document.createElement('button');
      signInBtn.type = 'button';
      signInBtn.className = 'secondary-auth-btn secondary-auth-signin';
      signInBtn.textContent = 'Conectare';
      signInBtn.addEventListener('click', () => clerk.openSignIn());

      const signUpBtn = document.createElement('button');
      signUpBtn.type = 'button';
      signUpBtn.className = 'secondary-auth-btn secondary-auth-signup';
      signUpBtn.textContent = 'Cont nou';
      signUpBtn.addEventListener('click', () => clerk.openSignUp());

      container.appendChild(signInBtn);
      container.appendChild(signUpBtn);
    }
  }

  // Populate after Clerk loads
  window.__crystalicaClerkReady?.then(populateSecondaryAuth);
  window.__crystalicaClerk?.addListener(populateSecondaryAuth);
  setTimeout(populateSecondaryAuth, 3000);
</script>
