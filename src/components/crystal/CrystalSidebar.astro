---
// CrystalSidebar.astro - Sticky sidebar with crystal metadata
interface Props {
  crystal: import('astro:content').CollectionEntry<'crystals'>;
}

const { crystal } = Astro.props;
const { data } = crystal;

const chakraColors: Record<string, string> = {
  'Chakra Rădăcină': 'chakra-root',
  'Chakra Sacrală': 'chakra-sacral',
  'Chakra Plex Solar': 'chakra-solar',
  'Chakra Inimii': 'chakra-heart',
  'Chakra Gâtului': 'chakra-throat',
  'Chakra A Treia Ochi': 'chakra-third-eye',
  'Chakra Coroanei': 'chakra-crown',
};

const chakraIcons: Record<string, string> = {
  'Chakra Rădăcină': '🔴',
  'Chakra Sacrală': '🟠',
  'Chakra Plex Solar': '🟡',
  'Chakra Inimii': '🟢',
  'Chakra Gâtului': '🔵',
  'Chakra A Treia Ochi': '🟣',
  'Chakra Coroanei': '🟪',
};

// Pre-compute category badge classes for template
const categoryBadges = data.category.map(cat => ({
  name: cat,
  class: `badge badge-${cat.toLowerCase().replace('ă','a').replace('ș','s').replace('ț','t').replace('î','i').replace('â','a')}`
}));
---

<aside aria-label="Informații detaliate cristal">
  <!-- Sticky container -->
  <div class="sticky top-24 space-y-6">
    <!-- Properties -->
    <div class="card p-6">
      <h3 class="font-heading text-lg font-medium mb-4">Proprietăți Energetice</h3>
      <ul class="space-y-2" role="list">
        {data.properties.map(prop => (
          <li class="flex items-start gap-2 text-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-crystal-teal)] mt-0.5 flex-shrink-0" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{prop}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Chakras -->
    {data.chakras.length > 0 && (
      <div class="card p-6">
        <h3 class="font-heading text-lg font-medium mb-4">Chakre</h3>
        <ul class="space-y-2" role="list">
          {data.chakras.map(chakra => (
            <li class="flex items-center gap-3 text-sm" role="listitem">
              <span class="text-lg" aria-hidden="true">{chakraIcons[chakra] || '⚫'}</span>
              <span class={chakraColors[chakra] || ''}>{chakra}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Zodiac -->
    {data.zodiac.length > 0 && (
      <div class="card p-6">
        <h3 class="font-heading text-lg font-medium mb-4">Zodiac</h3>
        <div class="flex flex-wrap gap-2" role="list">
          {data.zodiac.map(sign => (
            <span class="badge" role="listitem">{sign}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Elements -->
    {data.element.length > 0 && (
      <div class="card p-6">
        <h3 class="font-heading text-lg font-medium mb-4">Elemente</h3>
        <div class="flex flex-wrap gap-2" role="list">
          {data.element.map(el => (
            <span class="badge" role="listitem">{el}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Planet -->
    {data.planet && (
      <div class="card p-6">
        <h3 class="font-heading text-lg font-medium mb-4">Planeta</h3>
        <p class="text-sm">{data.planet}</p>
      </div>
    )}

    <!-- Origin -->
    {data.origin.length > 0 && (
      <div class="card p-6">
        <h3 class="font-heading text-lg font-medium mb-4">Origini</h3>
        <ul class="space-y-1 text-sm" role="list">
          {data.origin.map(o => <li role="listitem">🌍 {o}</li>)}
        </ul>
      </div>
    )}

    <!-- Affirmation -->
    {data.affirmation && (
      <div class="card p-6 bg-gradient-to-br from-[var(--color-crystal-teal)]/10 to-[var(--color-crystal-rose)]/10 border-[var(--color-crystal-teal)]/30">
        <h3 class="font-heading text-lg font-medium mb-3">Afirmație</h3>
        <blockquote class="font-accent italic text-base text-[var(--color-text)] leading-relaxed">
          {data.affirmation}
        </blockquote>
      </div>
    )}

    <!-- Uses -->
    {data.uses.length > 0 && (
      <div class="card p-6">
        <h3 class="font-heading text-lg font-medium mb-4">Folosințe</h3>
        <ul class="space-y-2 text-sm" role="list">
          {data.uses.map(use => (
            <li class="flex items-start gap-2" role="listitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-crystal-golden)] mt-0.5 flex-shrink-0" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              <span>{use}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</aside>