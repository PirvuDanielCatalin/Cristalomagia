---
// Header.astro - Navigation header
import SearchBar from '../SearchBar.astro';
import AuthControls from '../auth/AuthControls.astro';
---

<header class="header">
  <div class="header-inner">
    <nav class="header-nav" aria-label="Navigare principală">
      <!-- Logo -->
      <a href="/" class="logo" aria-label="Crystalica - Acasă">
        Crystal<span>ica</span>
      </a>

      <!-- Desktop Navigation - empty, search handles discovery -->
      <div class="nav-links"></div>

      <!-- Search + Auth + Mobile Menu -->
      <div class="header-actions">
        <!-- Search (desktop) -->
        <div class="search-wrapper hidden sm:block">
          <SearchBar variant="header" />
        </div>

        <!-- Auth (desktop) -->
        <AuthControls variant="desktop" />

        <!-- Mobile menu toggle -->
        <button class="menu-toggle lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Deschide meniul">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu-inner">
      <a href="/cristale" class="mobile-nav-link">
        <svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 2L22 8v16L16 30L10 24V8L16 2Z"/><path d="M16 8V24"/><path d="M10 16H22"/></svg>
        Cristale
      </a>

      <div class="mobile-menu-auth">
        <AuthControls variant="mobile" />
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.querySelector('.menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!expanded));
      mobileMenu.classList.toggle('open');
    });

    document.addEventListener('click', (e) => {
      if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('open');
      }
    });
  }
</script>
