---
// SearchBar.astro - Dynamic search with autocomplete
import { getCollection } from 'astro:content';

const crystals = await getCollection('crystals');
const sorted = [...crystals].sort((a, b) => a.data.name.localeCompare(b.data.name, 'ro'));

interface Props {
  placeholder?: string;
  variant?: 'header' | 'page';
}

const { placeholder = 'Caută cristale...', variant = 'header' } = Astro.props;
---

<div 
  class={`search-container ${variant === 'header' ? 'search-header' : 'search-page'}`}
  data-crystals={JSON.stringify(sorted.map(c => ({
    name: c.data.name,
    slug: c.data.slug,
    formula: c.data.chemicalFormula || '',
    image: c.data.image || '',
  })))}
>
  <div class="search-input-wrapper">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input 
      type="text" 
      class="search-field" 
      placeholder={placeholder}
      aria-label="Caută cristale"
      autocomplete="off"
    />
    <button class="search-clear" aria-label="Șterge căutarea" hidden>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  
  <div class="search-results" hidden>
    <div class="search-results-inner"></div>
  </div>
</div>

<style>
  .search-container {
    position: relative;
  }
  
  .search-header {
    width: 280px;
  }
  
  .search-page {
    max-width: 500px;
    margin: 0 auto var(--space-6);
  }
  
  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  
  .search-icon {
    position: absolute;
    left: var(--space-3);
    color: var(--color-text-light);
    pointer-events: none;
    z-index: 2;
  }
  
  .search-field {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    padding-left: calc(var(--space-3) + 16px + var(--space-2));
    padding-right: var(--space-8);
    font-size: var(--text-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    transition: all var(--transition-fast);
  }
  
  .search-field:focus {
    outline: none;
    border-color: var(--color-crystal-teal);
    box-shadow: 0 0 0 3px rgba(61, 155, 145, 0.1);
  }
  
  .search-field::placeholder {
    color: var(--color-text-light);
  }
  
  .search-clear {
    position: absolute;
    right: var(--space-2);
    padding: var(--space-1);
    background: none;
    border: none;
    color: var(--color-text-light);
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }
  
  .search-clear:hover {
    opacity: 1;
  }
  
  .search-results {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: var(--z-dropdown);
    max-height: 400px;
    overflow-y: auto;
  }
  
  .search-header .search-results {
    left: auto;
    right: 0;
    min-width: 320px;
  }
  
  .search-result-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-fast);
  }
  
  .search-result-item:last-child {
    border-bottom: none;
  }
  
  .search-result-item:hover,
  .search-result-item.active {
    background: rgba(61, 155, 145, 0.05);
  }
  
  .search-result-img {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    object-fit: cover;
    background: var(--color-earth-100);
    flex-shrink: 0;
  }
  
  .search-result-placeholder {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-earth-100) 0%, rgba(61,155,145,0.05) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-crystal-teal);
    opacity: 0.4;
    flex-shrink: 0;
  }
  
  .search-result-info {
    flex: 1;
    min-width: 0;
  }
  
  .search-result-name {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-zinc-900);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .search-result-formula {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono, monospace);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .search-no-results {
    padding: var(--space-4);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  const container = document.currentScript?.closest('.search-container');
  if (!container) {
    console.error('SearchBar: container not found');
  }
  
  let crystalData = [];
  try {
    crystalData = JSON.parse(container!.dataset.crystals || '[]');
  } catch (e) {
    console.error('SearchBar: invalid crystal data', e);
  }
  
  const input = container!.querySelector('.search-field') as HTMLInputElement;
  const results = container!.querySelector('.search-results') as HTMLElement;
  const resultsInner = container!.querySelector('.search-results-inner') as HTMLElement;
  const clearBtn = container!.querySelector('.search-clear') as HTMLElement;

  let activeIndex = -1;

  function renderResults(items) {
    if (items.length === 0) {
      resultsInner.innerHTML = '<div class="search-no-results">Niciun cristal găsit</div>';
      results.hidden = false;
      return;
    }

    resultsInner.innerHTML = items.map((item, i) => `
      <a href="/cristale/${item.slug}" class="search-result-item" data-index="${i}">
        ${item.image 
          ? `<img src="${item.image}" alt="" class="search-result-img" loading="lazy" />`
          : `<div class="search-result-placeholder">
               <svg width="20" height="20" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                 <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                 <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                 <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
               </svg>
             </div>`
        }
        <div class="search-result-info">
          <div class="search-result-name">${item.name}</div>
          ${item.formula ? `<div class="search-result-formula">${item.formula}</div>` : ''}
        </div>
      </a>
    `).join('');

    results.hidden = false;
  }

  function filterResults(query) {
    const q = query.toLowerCase().trim();
    if (!q) {
      results.hidden = true;
      clearBtn.hidden = true;
      return;
    }

    const filtered = crystalData.filter(c => 
      c.name.toLowerCase().includes(q) || 
      c.formula.toLowerCase().includes(q)
    );

    renderResults(filtered);
    clearBtn.hidden = query.length === 0;
    activeIndex = -1;
  }

  input.addEventListener('input', (e) => {
    filterResults(e.target.value);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    filterResults('');
    input.focus();
  });

  // Keyboard navigation
  input.addEventListener('keydown', (e) => {
    const items = resultsInner.querySelectorAll('.search-result-item');
    
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      items.forEach((item, i) => {
        item.classList.toggle('active', i === activeIndex);
      });
      items[activeIndex]?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      items.forEach((item, i) => {
        item.classList.toggle('active', i === activeIndex);
      });
      items[activeIndex]?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter' && activeIndex >= 0) {
      e.preventDefault();
      items[activeIndex].dispatchEvent(new MouseEvent('click', { bubbles: true }));
    } else if (e.key === 'Escape') {
      results.hidden = true;
      input.blur();
    }
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!container.contains(e.target)) {
      results.hidden = true;
    }
  });
</script>
