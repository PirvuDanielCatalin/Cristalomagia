---
// Header.astro - Two-navbar layout inspired by Fragrantica
// Primary nav: always visible (logo, Cristale link, search/profile)
// Secondary nav: scroll-aware (large search bar, auth controls)
---

<!-- Primary navbar (thin, always visible) -->
<header class="header-primary" data-header-primary>
  <div class="header-primary-inner">
    <a href="/" class="logo" aria-label="Crystalica - Acasă">
      <span class="logo-icon" aria-hidden="true">
        <svg width="20" height="24" viewBox="0 0 32 38" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
          <path d="M16 2L28 10v16L16 36 4 26V10L16 2Z"/>
          <path d="M16 2v34"/>
          <path d="M4 10l24 8"/>
          <path d="M4 26l24-8"/>
          <path d="M10 18h12"/>
        </svg>
      </span>
      <span class="logo-text">Crystalica</span>
    </a>

    <a href="/cristale" class="nav-link">Cristale</a>

    <div class="header-primary-actions">
      <!-- Search trigger icon -->
      <button type="button" class="icon-btn" data-search-trigger aria-label="Caută cristale">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Profile / account button (guest → sign-in modal, signed in → portfolio) -->
      <button type="button" class="profile-menu-btn" data-profile-trigger aria-label="Conectare">
        <span class="profile-menu-guest" data-profile-guest aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </span>
        <img class="profile-menu-avatar" data-profile-avatar alt="" hidden />
      </button>
    </div>
  </div>
</header>

<!-- Secondary navbar (scroll-aware, appears at top) -->
<div class="header-secondary" data-header-secondary hidden>
  <div class="header-secondary-inner">
    <!-- Large search bar -->
    <div class="secondary-search" data-secondary-search>
      <svg class="secondary-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" class="secondary-search-input" placeholder="Caută cristale..." aria-label="Caută cristale" data-secondary-search-input readonly />
    </div>

    <!-- Auth controls, right aligned -->
    <div class="header-secondary-auth" data-secondary-auth></div>
  </div>
</div>

<script is:inline>
  // ===== Scroll-aware secondary navbar =====
  (function initScrollNav() {
    const secondary = document.querySelector('[data-header-secondary]');
    if (!secondary) return;

    let lastScroll = 0;
    let ticking = false;

    function update() {
      const current = window.scrollY;
      const offset = 60; // Height of primary nav

      if (current < offset) {
        secondary.hidden = false;
        secondary.classList.add('visible');
      } else if (current > lastScroll) {
        secondary.classList.remove('visible');
        setTimeout(() => {
          if (!secondary.classList.contains('visible')) secondary.hidden = true;
        }, 300);
      } else {
        secondary.hidden = false;
        secondary.classList.add('visible');
      }
      lastScroll = current;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    });

    update();
  })();

  // ===== Search triggers → open overlay =====
  (function initSearchTriggers() {
    function openSearch() {
      if (typeof window.__crystalicaOpenSearch === 'function') {
        window.__crystalicaOpenSearch();
        return;
      }
      document.dispatchEvent(new CustomEvent('crystalica:open-search'));
    }

    document.querySelectorAll('[data-search-trigger], [data-secondary-search]').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        openSearch();
      });
    });
  })();

  // ===== Profile button + secondary auth =====
  (function initAccountControls() {
    const profileBtn = document.querySelector('[data-profile-trigger]');
    const avatar = document.querySelector('[data-profile-avatar]');
    const guestIcon = document.querySelector('[data-profile-guest]');
    const secondaryAuth = document.querySelector('[data-secondary-auth]');
    if (!profileBtn) return;

    function displayName(user) {
      return (
        user.fullName ||
        user.firstName ||
        user.emailAddresses?.[0]?.emailAddress?.split('@')[0] ||
        'Utilizator'
      );
    }

    // Clerk can throw synchronously if the UI bundle is still attaching.
    function openModal(clerk, kind) {
      const method = kind === 'signUp' ? 'openSignUp' : 'openSignIn';
      try {
        clerk[method]();
      } catch (error) {
        const message = error?.message || '';
        if (message.includes('Ui components') || message.includes('UI components')) {
          requestAnimationFrame(() => {
            try {
              clerk[method]();
            } catch (retryError) {
              console.error('[Crystalica] Failed to open auth modal:', retryError);
            }
          });
          return;
        }
        console.error('[Crystalica] Failed to open auth modal:', error);
      }
    }

    function renderProfile(clerk) {
      const user = clerk.user;

      if (user) {
        if (user.imageUrl && avatar) {
          avatar.src = user.imageUrl;
          avatar.hidden = false;
        } else if (avatar) {
          avatar.hidden = true;
        }
        if (guestIcon) guestIcon.hidden = true;
        profileBtn.setAttribute('aria-label', 'Portofoliul meu');
      } else {
        if (avatar) {
          avatar.hidden = true;
          avatar.removeAttribute('src');
        }
        if (guestIcon) guestIcon.hidden = false;
        profileBtn.setAttribute('aria-label', 'Conectare');
      }
    }

    function renderSecondaryAuth(clerk) {
      if (!secondaryAuth) return;

      const user = clerk.user;
      secondaryAuth.replaceChildren();

      if (user) {
        const name = document.createElement('button');
        name.type = 'button';
        name.className = 'secondary-user-name';
        name.textContent = displayName(user);
        name.addEventListener('click', () => {
          window.location.href = '/portofoliu';
        });

        const logout = document.createElement('button');
        logout.type = 'button';
        logout.className = 'secondary-logout-btn';
        logout.textContent = 'Deconectare';
        logout.addEventListener('click', () => {
          clerk.signOut().catch(console.error);
        });

        secondaryAuth.append(name, logout);
      } else {
        const signIn = document.createElement('button');
        signIn.type = 'button';
        signIn.className = 'secondary-auth-btn secondary-auth-signin';
        signIn.textContent = 'Conectare';
        signIn.addEventListener('click', () => openModal(clerk, 'signIn'));

        const signUp = document.createElement('button');
        signUp.type = 'button';
        signUp.className = 'secondary-auth-btn secondary-auth-signup';
        signUp.textContent = 'Cont nou';
        signUp.addEventListener('click', () => openModal(clerk, 'signUp'));

        secondaryAuth.append(signIn, signUp);
      }
    }

    function whenClerkReady(callback) {
      let done = false;
      const tryRun = () => {
        const clerk = window.__crystalicaClerk;
        if (!clerk || window.__crystalicaClerkStatus !== 'ready') return false;
        done = true;
        callback(clerk);
        return true;
      };

      if (tryRun()) return;

      const interval = setInterval(() => {
        if (tryRun()) clearInterval(interval);
      }, 100);

      setTimeout(() => clearInterval(interval), 20000);
    }

    profileBtn.addEventListener('click', () => {
      const clerk = window.__crystalicaClerk;
      if (!clerk) return;

      if (clerk.user) {
        window.location.href = '/portofoliu';
      } else {
        openModal(clerk, 'signIn');
      }
    });

    whenClerkReady((clerk) => {
      renderProfile(clerk);
      renderSecondaryAuth(clerk);

      clerk.addListener(() => {
        renderProfile(clerk);
        renderSecondaryAuth(clerk);
      });
    });
  })();
</script>
