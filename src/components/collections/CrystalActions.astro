---
interface Props {
  slug: string;
  variant?: 'card' | 'detail';
}

const { slug, variant = 'card' } = Astro.props;
const isDetail = variant === 'detail';
---

<div
  class:list={['crystal-actions', `crystal-actions-${variant}`]}
  data-collection-actions
  data-slug={slug}
  data-variant={variant}
  hidden
>
  {isDetail && <p class="crystal-actions-status" data-collection-status hidden></p>}

  <div class="crystal-actions-buttons">
    <button
      type="button"
      class="crystal-action crystal-action-p"
      data-collection-action
      data-next="p"
      hidden
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3l7 4v10l-7 4-7-4V7l7-4Z"/>
        <path d="M12 3v18"/>
      </svg>
      <span data-label-p>Portofoliu</span>
    </button>

    <button
      type="button"
      class="crystal-action crystal-action-w"
      data-collection-action
      data-next="w"
      hidden
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
      </svg>
      <span data-label-w>Wishlist</span>
    </button>

    <button
      type="button"
      class="crystal-action crystal-action-remove"
      data-collection-action
      data-next="none"
      hidden
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
      <span data-label-remove>Elimină</span>
    </button>
  </div>

  <p class="crystal-actions-error" data-collection-error hidden></p>
</div>
