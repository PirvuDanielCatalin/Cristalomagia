---
// FeaturedCrystals.astro - Featured crystals on homepage
import { getCollection } from 'astro:content';

const allCrystals = await getCollection('crystals');
const featuredCrystals = allCrystals
  .filter(c => c.data.featured)
  .slice(0, 6);

const fallbackCrystals = allCrystals.slice(0, 6);
const displayCrystals = featuredCrystals.length > 0 ? featuredCrystals : fallbackCrystals;

// Pre-compute template values to avoid literal interpolation issues
const crystalsWithData = displayCrystals.map((crystal, index) => ({
  ...crystal,
  animationDelay: `${index * 100}ms`,
  categoryBadges: crystal.data.category.map(cat => ({
    name: cat,
    slug: cat.toLowerCase()
      .replace('ă', 'a')
      .replace('ș', 's')
      .replace('ț', 't')
      .replace('î', 'i')
      .replace('â', 'a')
  }))
}));
---

<section class="section" aria-labelledby="featured-title">
  <div class="container">
    <header class="text-center mb-12 animate-fade-in">
      <h2 id="featured-title" class="font-heading text-3xl lg:text-4xl font-medium tracking-tight mb-4">
        Cristale În Evidență
      </h2>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
        O selecție din cele maiスペシャル cristale din colecție — puncte de plecare perfecte pentru explorare.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
      {crystalsWithData.map((crystal) => (
        <article class="card group animate-slide-up" style={`animation-delay: ${crystal.animationDelay};`} role="listitem">
          <a href={`/cristale/${crystal.slug}`} class="block" aria-label={`Vezi detalii despre ${crystal.data.name}`}>
            <!-- Crystal Image Placeholder -->
            <div class="aspect-square relative overflow-hidden bg-[var(--color-earth-100)]">
              {crystal.data.image ? (
                <img src={crystal.data.image} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-[var(--color-crystal-teal)]/10 to-[var(--color-crystal-rose)]/10">
                  <svg width="64" height="64" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-[var(--color-crystal-teal)]/30" aria-hidden="true">
                    <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
              )}
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                {crystal.categoryBadges.map(badge => (
                  <span class={`badge badge-${badge.slug}`} aria-hidden="true">{badge.name}</span>
                ))}
              </div>
            </div>

            <div class="p-5">
              <h3 class="font-heading text-lg font-medium mb-2 group-hover:text-[var(--color-crystal-teal)] transition-colors">
                {crystal.data.name}
              </h3>
              <p class="text-sm text-[var(--color-text-muted)] mb-3 line-clamp-2">
                {crystal.data.description}
              </p>
              <div class="flex flex-wrap gap-1.5" aria-label={`Proprietăți: ${crystal.data.properties.slice(0, 3).join(', ')}`}>
                {crystal.data.properties.slice(0, 3).map(prop => (
                  <span class="text-xs px-2 py-1 bg-[var(--color-earth-100)] text-[var(--color-earth-700)] rounded-full border border-[var(--color-border)]">
                    {prop}
                  </span>
                ))}
                {crystal.data.properties.length > 3 && (
                  <span class="text-xs px-2 py-1 bg-[var(--color-earth-100)] text-[var(--color-earth-500)] rounded-full border border-[var(--color-border)]">
                    +{crystal.data.properties.length - 3}
                  </span>
                )}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="text-center mt-10 animate-fade-in">
      <a href="/cristale" class="btn btn-secondary inline-flex items-center gap-2">
        Vezi Toate Cele 52 de Cristale
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>