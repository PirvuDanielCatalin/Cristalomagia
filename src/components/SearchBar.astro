---
// SearchBar.astro - Dynamic search with autocomplete
import { getCollection } from 'astro:content';

const crystals = await getCollection('crystals');
const sorted = [...crystals].sort((a, b) => a.data.name.localeCompare(b.data.name, 'ro'));

interface Props {
  placeholder?: string;
  variant?: 'header' | 'page';
}

const { placeholder = 'Caută cristale...', variant = 'header' } = Astro.props;
---

<div 
  class={`search-container ${variant === 'header' ? 'search-header' : 'search-page'}`}
  data-crystals={JSON.stringify(sorted.map(c => ({
    name: c.data.name,
    slug: c.data.slug,
    formula: c.data.chemicalFormula || '',
    image: c.data.image || '',
  })))}
  data-variant={variant}
>
  <div class="search-input-wrapper">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input 
      type="text" 
      class="search-field" 
      placeholder={placeholder}
      aria-label="Caută cristale"
      autocomplete="off"
    />
    <button class="search-clear" aria-label="Șterge căutarea" hidden>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  
  <div class="search-results" hidden>
    <div class="search-results-inner"></div>
  </div>
</div>

<style>
  .search-container {
    position: relative;
  }
  
  .search-header {
    width: 280px;
  }
  
  .search-page {
    max-width: 500px;
    margin: 0 auto var(--space-6);
  }
  
  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  
  .search-icon {
    position: absolute;
    left: var(--space-3);
    color: var(--color-text-light);
    pointer-events: none;
    z-index: 2;
  }
  
  .search-field {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    padding-left: calc(var(--space-3) + 16px + var(--space-2));
    padding-right: var(--space-8);
    font-size: var(--text-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    transition: all var(--transition-fast);
  }
  
  .search-field:focus {
    outline: none;
    border-color: var(--color-crystal-teal);
    box-shadow: 0 0 0 3px rgba(61, 155, 145, 0.1);
  }
  
  .search-field::placeholder {
    color: var(--color-text-light);
  }
  
  .search-clear {
    position: absolute;
    right: var(--space-2);
    padding: var(--space-1);
    background: none;
    border: none;
    color: var(--color-text-light);
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }
  
  .search-clear:hover {
    opacity: 1;
  }
  
  .search-results {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 9999;
    max-height: 400px;
    overflow-y: auto;
  }
  
  .search-header .search-results {
    /* Match the search bar width exactly */
    left: 0;
    right: 0;
    min-width: 0;
    /* Exactly 5 results visible (48px each), scroll for the rest */
    max-height: calc(5 * 48px);
    overscroll-behavior: contain;
  }
  
  .search-header .search-field {
    font-size: var(--text-base);
  }
  
  /* Result rows are injected via JS, so they must be styled globally:
     Astro scoped styles do not apply to innerHTML content. */
  :global(.search-results-inner) {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  
  :global(.search-result-item) {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 48px;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      padding-left var(--transition-fast);
  }
  
  :global(.search-result-item:last-child) {
    border-bottom: none;
  }
  
  :global(.search-result-item:hover),
  :global(.search-result-item.active) {
    background: var(--color-bg-hover);
    color: var(--color-crystal-teal);
    padding-left: calc(var(--space-4) + var(--space-1));
  }
  
  :global(.search-result-name) {
    display: block;
    width: 100%;
    font-weight: 500;
    font-size: inherit;
    color: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  :global(.search-no-results) {
    padding: var(--space-4);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  // Handle multiple SearchBar instances on the same page
  const allContainers = document.querySelectorAll('[data-crystals]');
  
  function initSearchBar(container) {
    let crystalData = [];
    try {
      crystalData = JSON.parse(container.dataset.crystals || '[]');
    } catch (e) {
      console.error('SearchBar: invalid crystal data', e);
      return;
    }
    
    const variant = container.dataset.variant || 'header';
    const input = container.querySelector('.search-field');
    const results = container.querySelector('.search-results');
    const resultsInner = container.querySelector('.search-results-inner');
    const clearBtn = container.querySelector('.search-clear');

    if (!input || !clearBtn) return;

    let activeIndex = -1;

    // Header variant: show dropdown with names only
    function renderDropdown(items) {
      if (!resultsInner || !results) return;
      
      if (items.length === 0) {
        resultsInner.innerHTML = '<div class="search-no-results">Niciun cristal găsit</div>';
        results.hidden = false;
        return;
      }

      resultsInner.innerHTML = items.map((item, i) => `
        <a href="/cristale/${item.slug}" class="search-result-item" data-index="${i}">
          <span class="search-result-name">${item.name}</span>
        </a>
      `).join('');

      results.hidden = false;
    }

    // Page variant: filter crystal cards
    function filterCards(query) {
      const q = query.toLowerCase().trim();
      const cards = document.querySelectorAll<HTMLElement>('[data-crystal-card]');
      let visibleCount = 0;
      
      cards.forEach(card => {
        const name = (card.dataset.name || '').toLowerCase();
        const matches = !q || name.includes(q);
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });

      // Hide/show empty letter groups
      document.querySelectorAll('.az-group').forEach(group => {
        const hasVisible = [...group.querySelectorAll<HTMLElement>('[data-crystal-card]')].some(c => c.style.display !== 'none');
        group.style.display = hasVisible ? '' : 'none';
      });

      // Update count text
      const countEl = document.querySelector('.section header p');
      if (countEl) {
        countEl.textContent = q ? `${visibleCount} cristale găsite` : `${crystalData.length} cristale, organizate alfabetic.`;
      }
    }

    function handleInput(value) {
      const q = value.toLowerCase().trim();
      
      if (!q) {
        if (results) results.hidden = true;
        clearBtn.hidden = true;
        if (variant === 'page') {
          filterCards('');
        }
        return;
      }

      if (variant === 'page') {
        if (results) results.hidden = true;
        filterCards(value);
      } else {
        const filtered = crystalData.filter(c => 
          c.name.toLowerCase().includes(q) || 
          c.formula.toLowerCase().includes(q)
        );
        renderDropdown(filtered);
      }
      
      clearBtn.hidden = value.length === 0;
      activeIndex = -1;
    }

    input.addEventListener('input', (e) => {
      handleInput(e.target.value);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      handleInput('');
      input.focus();
    });

    // Keyboard navigation (dropdown only)
    input.addEventListener('keydown', (e) => {
      if (variant === 'page' || !resultsInner || !results) return;
      
      const items = resultsInner.querySelectorAll('.search-result-item');
      
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, items.length - 1);
        items.forEach((item, i) => {
          item.classList.toggle('active', i === activeIndex);
        });
        items[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        items.forEach((item, i) => {
          item.classList.toggle('active', i === activeIndex);
        });
        items[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        e.preventDefault();
        items[activeIndex]?.dispatchEvent(new MouseEvent('click', { bubbles: true }));
      } else if (e.key === 'Escape') {
        results.hidden = true;
        input.blur();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target) && results) {
        results.hidden = true;
      }
    });
  }

  allContainers.forEach(initSearchBar);
</script>
