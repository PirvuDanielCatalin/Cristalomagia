---
// Footer.astro - Site footer
---

<footer class="footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">Cristalo<span>magia</span></a>
        <p class="footer-desc">
          Enciclopedia ta personală de cristale. Descoperă proprietățile energetice, istorii, chakre, zodiac și folosințe practice pentru fiecare cristal.
        </p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Navigare site">
        <h4 class="footer-title">Explorează</h4>
        <ul class="footer-links">
          <li><a href="/cristale" class="footer-link">Toate Cristalele</a></li>
          <li><a href="/categorii" class="footer-link">Categorii</a></li>
          <li><a href="/cautare" class="footer-link">Caută Cristale</a></li>
          <li><a href="/despre" class="footer-link">Despre Proiect</a></li>
        </ul>
      </nav>

      <!-- Categories -->
      <nav aria-label="Categorii principale">
        <h4 class="footer-title">Categorii</h4>
        <ul class="footer-links">
          <li><a href="/categorii/cristale" class="footer-link">Cristale</a></li>
          <li><a href="/categorii/pendule" class="footer-link">Pendule</a></li>
          <li><a href="/categorii/bratari" class="footer-link">Brățari</a></li>
          <li><a href="/categorii/pandantive" class="footer-link">Pandanțive</a></li>
          <li><a href="/categorii/obelisc" class="footer-link">Obelisci</a></li>
        </ul>
      </nav>

      <!-- Connect -->
      <div>
        <h4 class="footer-title">Comunitate</h4>
        <ul class="footer-links">
          <li><a href="/rss.xml" class="footer-link" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="margin-right: 6px;"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
            Feed RSS
          </a></li>
          <li><a href="mailto:contact@cristalomagia.com" class="footer-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="margin-right: 6px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Contact
          </a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">© {new Date().getFullYear()} Cristalomagia. Toate drepturile rezervate.</p>
      <div class="flex items-center gap-6 text-xs" style="color: var(--color-zinc-500);">
        <a href="/confidentialitate" class="footer-link">Confidențialitate</a>
        <a href="/termeni" class="footer-link">Termeni</a>
        <a href="/cookies" class="footer-link">Cookie-uri</a>
      </div>
    </div>
  </div>
</footer>