---
// src/pages/portofoliu.astro - Personal crystal portfolio (client-rendered from Clerk metadata)
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const crystals = await getCollection('crystals');
const sorted = [...crystals].sort((a, b) => a.data.name.localeCompare(b.data.name, 'ro'));

const crystalIndex = sorted.map((crystal) => ({
  name: crystal.data.name,
  slug: crystal.data.slug,
  image: crystal.data.image || '',
  formula: crystal.data.chemicalFormula || '',
}));
---

<BaseLayout
  title="Portofoliul meu — Crystalica"
  description="Portofoliul tău de cristale și lista de dorințe, sincronizate cu contul tău."
  noIndex
>
  <div class="portfolio-page" data-portfolio-page>
    <!-- Guest gate: shown only when unauthenticated -->
    <div class="portfolio-gate" data-portfolio-gate hidden>
      <div class="portfolio-gate-inner">
        <h1>Portofoliul meu</h1>
        <p>Conectează-te ca să vezi portofoliul și lista de dorințe.</p>
        <button type="button" class="portfolio-signin-btn" data-portfolio-sign-in>
          Conectare
        </button>
      </div>
    </div>

    <!-- Loading state -->
    <div class="portfolio-loading" data-portfolio-loading>Se încarcă portofoliul...</div>

    <!-- Error state -->
    <p class="portfolio-error" data-portfolio-error hidden></p>

    <!-- Main content (shown only when authenticated) -->
    <div class="portfolio-content" data-portfolio-content hidden>
      <!-- Central header banner with user info -->
      <header class="portfolio-profile-header relative px-4 sm:px-6 pb-5 sm:pb-6">
        <div class="portfolio-profile-avatar">
          <img src="" alt="" data-profile-img hidden />
          <div class="portfolio-avatar-placeholder" data-avatar-placeholder aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
        </div>
        <div class="portfolio-profile-info">
          <h1 class="portfolio-profile-name" data-profile-name></h1>
          <div class="portfolio-profile-stats">
            <span class="portfolio-stat">
              <strong data-portfolio-count>0</strong> cristale în portofoliu
            </span>
            <span class="portfolio-stat-separator" aria-hidden="true">·</span>
            <span class="portfolio-stat">
              <strong data-wishlist-count>0</strong> în lista de dorințe
            </span>
          </div>
        </div>
      </header>

      <!-- Two-panel layout: sidebar left, content right -->
      <div class="portfolio-layout">
        <!-- Left sidebar -->
        <aside class="portfolio-sidebar overflow-x-auto overflow-y-hidden scrollbar-hide -mb-px overscroll-x-contain xl:overflow-visible xl:mb-0 xl:p-3 xl:sticky xl:top-20">
          <nav class="portfolio-nav">
            <button type="button" class="portfolio-nav-item portfolio-nav-active" data-nav-tab="portfolio">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3l7 4v10l-7 4-7-4V7l7-4Z"/>
                <path d="M12 3v18"/>
              </svg>
              Portofoliul personal
            </button>
            <button type="button" class="portfolio-nav-item" data-nav-tab="settings">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
              Configurație cont
            </button>
          </nav>
        </aside>

        <!-- Right content area -->
        <main class="portfolio-main p-3 sm:p-4 flex flex-col gap-4 xl:flex-row xl:gap-6 xl:justify-center bg-zinc-50 dark:bg-zinc-900">
          <!-- Portfolio tab (shows both lists together) -->
          <section class="portfolio-tab portfolio-tab-active" data-tab="portfolio">
            <div class="portfolio-tab-header">
              <h2>Portofoliul meu</h2>
              <span class="portfolio-tab-count" data-portfolio-count-2>0 cristale</span>
            </div>

            <div class="portfolio-section">
              <h3 class="portfolio-section-title">Portofoliu</h3>
              <div class="portfolio-grid" data-portfolio-grid></div>
              <p class="portfolio-empty" data-portfolio-empty hidden>Nu ai încă cristale în portofoliu.</p>
            </div>

            <div class="portfolio-section">
              <h3 class="portfolio-section-title">Lista de dorințe</h3>
              <div class="portfolio-grid" data-wishlist-grid></div>
              <p class="portfolio-empty" data-wishlist-empty hidden>Nu ai niciun cristal în lista de dorințe.</p>
            </div>
          </section>

          <!-- Settings tab -->
          <section class="portfolio-tab" data-tab="settings" hidden>
            <div class="portfolio-tab-header">
              <h2>Configurație cont</h2>
            </div>
            <div class="portfolio-settings">
              <div class="portfolio-settings-section">
                <h3>Profil</h3>
                <button type="button" class="portfolio-settings-btn" data-open-profile>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                  </svg>
                  Modifică poza de profil
                </button>
                <button type="button" class="portfolio-settings-btn" data-open-password>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  Schimbă parola
                </button>
              </div>
              <div class="portfolio-settings-section">
                <h3>Cont</h3>
                <button type="button" class="portfolio-settings-btn portfolio-settings-btn-danger" data-logout-btn>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                  </svg>
                  Deconectare
                </button>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="crystal-index" set:html={JSON.stringify(crystalIndex)}></script>
</BaseLayout>

<script>
  type CollectionState = 'p' | 'w';
  type CollectionsMap = Record<string, CollectionState>;

  function waitForClerkReady(timeout = 15000): Promise<any> {
    return new Promise((resolve, reject) => {
      const start = Date.now();
      const check = () => {
        const clerk = window.__crystalicaClerk;
        if (clerk && window.__crystalicaClerkStatus === 'ready') {
          resolve(clerk);
        } else if (Date.now() - start > timeout) {
          reject(new Error('Clerk did not load within timeout'));
        } else {
          setTimeout(check, 100);
        }
      };
      check();
    });
  }

  function readCollections(user: unknown): CollectionsMap {
    const metadata = (user as { unsafeMetadata?: Record<string, unknown> } | null | undefined)?.unsafeMetadata;
    const raw = metadata?.collections;
    const collections: CollectionsMap = {};

    if (typeof raw === 'string') {
      for (const entry of raw.split(',')) {
        const separator = entry.lastIndexOf(':');
        if (separator <= 0) continue;
        const slug = entry.slice(0, separator);
        const state = entry.slice(separator + 1);
        if (slug && (state === 'p' || state === 'w')) {
          collections[slug] = state;
        }
      }
      return collections;
    }

    if (raw && typeof raw === 'object') {
      for (const [slug, value] of Object.entries(raw as Record<string, unknown>)) {
        if (value === 'p' || value === 'w') {
          collections[slug] = value;
        }
      }
    }

    return collections;
  }

  async function saveCollections(user: any, collections: CollectionsMap): Promise<void> {
    const unsafeMetadata = {
      ...(user.unsafeMetadata ?? {}),
      collections: Object.entries(collections)
        .map(([slug, state]) => `${slug}:${state}`)
        .join(','),
    };

    await user.update({ unsafeMetadata });
    document.dispatchEvent(
      new CustomEvent<CollectionsMap>('crystalica:collections', { detail: collections }),
    );
  }

  interface CrystalIndexItem {
    name: string;
    slug: string;
    image: string;
    formula: string;
  }

  const indexElement = document.querySelector<HTMLElement>('#crystal-index');
  const crystalIndex: CrystalIndexItem[] = indexElement?.textContent
    ? JSON.parse(indexElement.textContent)
    : [];

  const page = document.querySelector<HTMLElement>('[data-portfolio-page]');
  const gate = document.querySelector<HTMLElement>('[data-portfolio-gate]');
  const loading = document.querySelector<HTMLElement>('[data-portfolio-loading]');
  const content = document.querySelector<HTMLElement>('[data-portfolio-content]');
  const errorBox = document.querySelector<HTMLElement>('[data-portfolio-error]');
  const portfolioGrid = document.querySelector<HTMLElement>('[data-portfolio-grid]');
  const wishlistGrid = document.querySelector<HTMLElement>('[data-wishlist-grid]');
  const portfolioEmpty = document.querySelector<HTMLElement>('[data-portfolio-empty]');
  const wishlistEmpty = document.querySelector<HTMLElement>('[data-wishlist-empty]');
  const portfolioCount = document.querySelector<HTMLElement>('[data-portfolio-count]');
  const portfolioCount2 = document.querySelector<HTMLElement>('[data-portfolio-count-2]');
  const wishlistCount = document.querySelector<HTMLElement>('[data-wishlist-count]');
  const wishlistCount2 = document.querySelector<HTMLElement>('[data-wishlist-count-2]');
  const profileName = document.querySelector<HTMLElement>('[data-profile-name]');
  const profileImg = document.querySelector<HTMLImageElement>('[data-profile-img]');
  const avatarPlaceholder = document.querySelector<HTMLElement>('[data-avatar-placeholder]');
  const signInButton = document.querySelector<HTMLButtonElement>('[data-portfolio-sign-in]');
  const logoutButton = document.querySelector<HTMLButtonElement>('[data-logout-btn]');
  const openProfileButton = document.querySelector<HTMLButtonElement>('[data-open-profile]');
  const openPasswordButton = document.querySelector<HTMLButtonElement>('[data-open-password]');
  const navItems = document.querySelectorAll<HTMLElement>('[data-nav-tab]');
  const tabs = document.querySelectorAll<HTMLElement>('[data-tab]');

  let collections: CollectionsMap = {};

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function displayName(user: any): string {
    return user.fullName || user.firstName || user.emailAddresses?.[0]?.emailAddress?.split('@')[0] || 'Utilizator';
  }

  function renderItem(item: CrystalIndexItem, state: 'p' | 'w'): string {
    const image = item.image
      ? `<img src="${escapeHtml(item.image)}" alt="" loading="lazy" />`
      : `<div class="portfolio-item-placeholder">
           <svg width="36" height="36" viewBox="0 0 32 32" fill="none" aria-hidden="true">
             <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
             <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
             <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
           </svg>
         </div>`;

    const moveButton =
      state === 'w'
        ? `<button type="button" class="portfolio-action portfolio-action-move" data-portfolio-move="${escapeHtml(item.slug)}" data-next="p">Mută în portofoliu</button>`
        : `<button type="button" class="portfolio-action portfolio-action-move portfolio-action-move-w" data-portfolio-move="${escapeHtml(item.slug)}" data-next="w">Mută în lista de dorințe</button>`;

    return `<article class="portfolio-item" data-state="${state === 'p' ? 'portfolio' : 'wishlist'}">
      <a href="/cristale/${escapeHtml(item.slug)}" class="portfolio-item-link">
        <div class="portfolio-item-img">${image}</div>
        <div class="portfolio-item-body">
          <span class="portfolio-item-name">${escapeHtml(item.name)}</span>
        </div>
      </a>
      <div class="portfolio-item-actions">
        ${moveButton}
        <button type="button" class="portfolio-action portfolio-action-remove" data-portfolio-remove="${escapeHtml(item.slug)}">Elimină</button>
      </div>
    </article>`;
  }

  function render() {
    const clerk = window.__crystalicaClerk;

    if (!clerk) {
      if (loading) loading.textContent = 'Autentificarea nu este configurată.';
      return;
    }

    const signedIn = Boolean(clerk.user);

    if (loading) loading.hidden = true;
    if (gate) gate.hidden = signedIn;
    if (content) content.hidden = !signedIn;

    if (!signedIn) return;

    const user = clerk.user;
    if (profileName) profileName.textContent = displayName(user);
    if (profileImg && user.imageUrl) {
      profileImg.src = user.imageUrl;
      profileImg.hidden = false;
      if (avatarPlaceholder) avatarPlaceholder.hidden = true;
    } else if (profileImg) {
      profileImg.hidden = true;
      if (avatarPlaceholder) avatarPlaceholder.hidden = false;
    }

    const portfolio = crystalIndex.filter((item) => collections[item.slug] === 'p');
    const wishlist = crystalIndex.filter((item) => collections[item.slug] === 'w');

    if (portfolioGrid) {
      portfolioGrid.innerHTML = portfolio.map((item) => renderItem(item, 'p')).join('');
    }
    if (wishlistGrid) {
      wishlistGrid.innerHTML = wishlist.map((item) => renderItem(item, 'w')).join('');
    }

    if (portfolioEmpty) portfolioEmpty.hidden = portfolio.length > 0;
    if (wishlistEmpty) wishlistEmpty.hidden = wishlist.length > 0;
    if (portfolioCount) portfolioCount.textContent = String(portfolio.length);
    if (wishlistCount) wishlistCount.textContent = String(wishlist.length);
    if (portfolioCount2) portfolioCount2.textContent = `${portfolio.length} cristale`;
    if (wishlistCount2) wishlistCount2.textContent = `${wishlist.length} cristale`;
    if (errorBox) errorBox.hidden = true;
  }

  function syncFromUser() {
    const clerk = window.__crystalicaClerk;
    collections = readCollections(clerk?.user);
  }

  function switchTab(tabName: string) {
    navItems.forEach((item) => {
      const isActive = item.dataset.navTab === tabName;
      item.classList.toggle('portfolio-nav-active', isActive);
    });
    tabs.forEach((tab) => {
      const isTarget = tab.dataset.tab === tabName;
      tab.hidden = !isTarget;
      tab.classList.toggle('portfolio-tab-active', isTarget);
    });
  }

  navItems.forEach((item) => {
    item.addEventListener('click', () => {
      if (item.dataset.navTab) switchTab(item.dataset.navTab);
    });
  });

  document.addEventListener('click', async (event) => {
    const clerk = window.__crystalicaClerk;
    const button = (event.target as Element | null)?.closest<HTMLElement>(
      '[data-portfolio-move], [data-portfolio-remove]',
    );

    if (!button || !clerk?.user) return;

    const slug = button.dataset.portfolioMove || button.dataset.portfolioRemove;
    if (!slug) return;

    const next = button.dataset.next;
    if (!button.dataset.portfolioRemove && next !== 'p' && next !== 'w') return;

    const previous = collections;
    const nextCollections: CollectionsMap = { ...collections };

    if (button.dataset.portfolioRemove) {
      delete nextCollections[slug];
    } else {
      nextCollections[slug] = next as CollectionState;
    }

    collections = nextCollections;
    render();

    try {
      await saveCollections(clerk.user, nextCollections);
    } catch (error) {
      collections = previous;
      render();

      if (errorBox) {
        errorBox.hidden = false;
        errorBox.textContent = 'Nu am putut salva modificarea. Încearcă din nou.';
      }

      console.error('[Crystalica] Nu am putut salva portofoliul.', error);
    }
  });

  signInButton?.addEventListener('click', () => {
    const clerk = window.__crystalicaClerk;
    if (!clerk) return;
    signInButton.disabled = true;
    clerk.openSignIn().finally(() => {
      signInButton.disabled = false;
    });
  });

  logoutButton?.addEventListener('click', async () => {
    const clerk = window.__crystalicaClerk;
    if (!clerk) return;
    await clerk.signOut();
    window.location.reload();
  });

  openProfileButton?.addEventListener('click', () => {
    const clerk = window.__crystalicaClerk;
    if (!clerk) return;
    try {
      clerk.openUserProfile();
    } catch (error) {
      console.error('[Crystalica] Failed to open profile:', error);
    }
  });

  openPasswordButton?.addEventListener('click', () => {
    const clerk = window.__crystalicaClerk;
    if (!clerk) return;
    try {
      clerk.openUserProfile();
    } catch (error) {
      console.error('[Crystalica] Failed to open profile:', error);
    }
  });

  document.addEventListener('crystalica:collections', (event) => {
    const detail = (event as CustomEvent<CollectionsMap>).detail;
    if (!detail) return;
    collections = detail;
    render();
  });

  async function init() {
    try {
      await waitForClerkReady();
      const clerk = window.__crystalicaClerk;

      if (!clerk) {
        if (loading) loading.textContent = 'Autentificarea nu este configurată.';
        return;
      }

      syncFromUser();
      render();

      let lastUserId = clerk.user?.id ?? null;

      clerk.addListener(() => {
        const userId = clerk.user?.id ?? null;
        if (userId === lastUserId) return;
        lastUserId = userId;
        syncFromUser();
        render();
      });
    } catch (error) {
      if (loading) loading.hidden = true;
      if (errorBox) {
        errorBox.hidden = false;
        errorBox.textContent = 'Autentificarea nu este disponibilă momentan. Reîncarcă pagina.';
      }
    }
  }

  void init();
</script>

<style>
  .portfolio-page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  .portfolio-gate {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--space-8);
    border: none !important;
    background: transparent !important;
  }

  .portfolio-gate-inner {
    text-align: center;
    max-width: 400px;
    border: none !important;
    background: transparent !important;
  }

  .portfolio-gate[hidden] {
    display: none;
  }

  .portfolio-gate-inner {
    text-align: center;
    max-width: 400px;
  }

  .portfolio-gate h1 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .portfolio-gate p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .portfolio-signin-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
    font-family: var(--font-body);
    color: var(--color-text);
    background: transparent;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .portfolio-signin-btn:hover {
    border-color: var(--color-crystal-teal);
    color: var(--color-crystal-teal);
    transform: scale(1.02);
  }

  .portfolio-loading,
  .portfolio-error {
    padding: var(--space-12) var(--space-6);
    text-align: center;
    color: var(--color-text-muted);
  }

  .portfolio-error[hidden],
  .portfolio-loading[hidden] {
    display: none;
  }

  .portfolio-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-6);
  }

  @media (min-width: 640px) {
    .portfolio-content {
      padding: var(--space-4) var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .portfolio-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-8);
    }
  }

  .portfolio-profile-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-6);
  }

  .portfolio-profile-avatar {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    overflow: hidden;
    background: var(--color-earth-100);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .portfolio-profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portfolio-profile-avatar img[hidden] {
    display: none;
  }

  .portfolio-avatar-placeholder {
    color: var(--color-crystal-teal);
    opacity: 0.5;
  }

  .portfolio-avatar-placeholder[hidden] {
    display: none;
  }

  .portfolio-profile-info {
    flex: 1;
    min-width: 0;
  }

  .portfolio-profile-name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0 0 var(--space-1);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .portfolio-profile-stats {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .portfolio-stat strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .portfolio-layout {
    display: grid;
  }

  .portfolio-sidebar {
    width: 100%;
    margin-bottom: var(--space-6);
  }

  @media (min-width: 1024px) {
    .portfolio-layout {
      grid-template-columns: 280px 1fr;
      gap: var(--space-6);
      align-items: start;
    }

    .portfolio-sidebar {
      width: auto;
      margin-bottom: 0;
    }
  }

  .portfolio-nav {
