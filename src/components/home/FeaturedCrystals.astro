---
// FeaturedCrystals.astro - Featured crystals on homepage
import { getCollection } from 'astro:content';

const allCrystals = await getCollection('crystals');
const featuredCrystals = allCrystals
  .filter(c => c.data.featured)
  .slice(0, 6);

const fallbackCrystals = allCrystals.slice(0, 6);
const displayCrystals = featuredCrystals.length > 0 ? featuredCrystals : fallbackCrystals;

// Pre-compute template values
const crystalsWithData = displayCrystals.map((crystal, index) => ({
  ...crystal,
  animationDelay: `${index * 80}ms`,
  categoryBadges: crystal.data.category.map(cat => ({
    name: cat,
    slug: cat.toLowerCase()
      .replace('ă', 'a')
      .replace('ș', 's')
      .replace('ț', 't')
      .replace('î', 'i')
      .replace('â', 'a')
  }))
}));
---

<section class="section section--light" aria-labelledby="featured-title">
  <div class="container">
    <!-- Section Header -->
    <header class="text-center mb-12 animate-fade-in">
      <h2 id="featured-title" class="font-heading text-3xl lg:text-4xl font-medium tracking-tight mb-4 text-[var(--color-zinc-900)]">
        Cristale În Evidență
      </h2>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
        O selecție din cele mai apreciate cristale — puncte de plecare perfecte pentru explorare.
      </p>
    </header>

    <!-- Crystal Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
      {crystalsWithData.map((crystal) => (
        <article class="card card-clickable animate-slide-up" style={`animation-delay: ${crystal.animationDelay};`} role="listitem">
          <a href={`/cristale/${crystal.slug}`} class="block" aria-label={`Vezi detalii despre ${crystal.data.name}`}>
            <!-- Image -->
            <div class="card-img-container">
              {crystal.data.image ? (
                <img src={crystal.data.image} alt="" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-earth-100) 0%, var(--color-crystal-teal)/0.1 100%);">
                  <svg width="48" height="48" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-[var(--color-crystal-teal)]/40" aria-hidden="true">
                    <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
              )}
              <!-- Badges overlay -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                {crystal.categoryBadges.map(badge => (
                  <span class={`badge badge-${badge.slug}`} aria-hidden="true">{badge.name}</span>
                ))}
              </div>
            </div>

            <!-- Content -->
            <div class="card-body">
              <h3 class="card-title">
                {crystal.data.name}
              </h3>
              <p class="card-description">
                {crystal.data.description}
              </p>
              <!-- Properties -->
              <div class="flex flex-wrap gap-1.5 mt-2" aria-label={`Proprietăți: ${crystal.data.properties.slice(0, 3).join(', ')}`}>
                {crystal.data.properties.slice(0, 3).map(prop => (
                  <span class="badge" style="font-size: 0.6rem; padding: 0.15rem 0.5rem;">
                    {prop}
                  </span>
                ))}
                {crystal.data.properties.length > 3 && (
                  <span class="badge" style="font-size: 0.6rem; padding: 0.15rem 0.5rem; color: var(--color-text-muted);">
                    +{crystal.data.properties.length - 3}
                  </span>
                )}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12 animate-fade-in">
      <a href="/cristale" class="btn btn-secondary inline-flex items-center gap-2 px-8 py-3">
        Vezi Toate Cele {allCrystals.length} de Cristale
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>