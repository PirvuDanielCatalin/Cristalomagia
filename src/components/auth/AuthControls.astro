---
interface Props {
  variant?: 'desktop' | 'mobile' | 'icon';
}

const { variant = 'desktop' } = Astro.props;
---

<div class:list={['auth-controls', `auth-controls-${variant}`]} data-auth-controls data-variant={variant}>
  <!-- Loading spinner – hidden while Clerk initializes -->
  <div class="auth-loading" data-auth-loading hidden>
    <svg class="auth-loading-spinner" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-dasharray="31.4 31.4" stroke-linecap="round"/>
    </svg>
  </div>

  {variant === 'icon' ? (
    // Icon-only variant for primary navbar
    <div class="auth-icon-guest" data-auth-guest hidden>
      <button type="button" class="auth-icon-btn auth-icon-btn-signin" data-auth-sign-in aria-label="Conectare">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
          <polyline points="10 17 15 12 10 7"/>
          <line x1="15" y1="12" x2="3" y2="12"/>
        </svg>
      </button>
      <button type="button" class="auth-icon-btn auth-icon-btn-signup" data-auth-sign-up aria-label="Cont nou">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <line x1="19" y1="8" x2="19" y2="14"/>
          <line x1="22" y1="11" x2="16" y2="11"/>
        </svg>
      </button>
    </div>

    <div class="auth-icon-user" data-auth-user hidden>
      <button type="button" class="auth-icon-btn auth-icon-btn-portfolio" data-auth-portfolio aria-label="Portofoliul meu">
        <svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 2L28 10v16L16 30 4 18V10L16 2Z"/>
          <path d="M16 2v28"/>
          <path d="M4 10l24 8"/>
          <path d="M4 18l24-8"/>
        </svg>
      </button>
      <button type="button" class="auth-icon-btn auth-icon-btn-logout" data-auth-logout aria-label="Deconectare">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </button>
    </div>
  ) : (
    // Original desktop/mobile variants
    <>
      <div class="auth-guest" data-auth-guest hidden>
        <button type="button" class="auth-btn auth-btn-ghost" data-auth-sign-in>
          Conectare
        </button>
        <button type="button" class="auth-btn auth-btn-primary" data-auth-sign-up>
          Cont nou
        </button>
      </div>

      <div class="auth-user" data-auth-user hidden>
        <span class="auth-user-name" data-auth-user-name></span>
        <a href="/portofoliu" class="auth-portfolio-link" data-auth-portfolio-link>Portofoliul meu</a>
        <button type="button" class="auth-btn auth-btn-ghost auth-btn-logout" data-auth-logout>Deconectare</button>
      </div>
    </>
  )}
</div>

<script>
  // Wait for Clerk to be available from CDN before initializing
  function waitForClerk(timeout = 10000): Promise<void> {
    return new Promise((resolve, reject) => {
      const start = Date.now();
      const check = () => {
        if (window.__crystalicaClerk) {
          resolve();
        } else if (Date.now() - start > timeout) {
          reject(new Error('Clerk did not load within timeout'));
        } else {
          setTimeout(check, 100);
        }
      };
      check();
    });
  }

  function initAuthControls(root: HTMLElement) {
    const loading = root.querySelector<HTMLElement>('[data-auth-loading]');
    const guest = root.querySelector<HTMLElement>('[data-auth-guest]');
    const userBox = root.querySelector<HTMLElement>('[data-auth-user]');
    const userName = root.querySelector<HTMLElement>('[data-auth-user-name]');
    const portfolioLink = root.querySelector<HTMLAnchorElement>('[data-auth-portfolio-link]');
    const logoutBtn = root.querySelector<HTMLButtonElement>('[data-auth-logout]');
    const avatar = root.querySelector<HTMLDivElement>('[data-auth-avatar]');
    const iconGuest = root.querySelector<HTMLElement>('[data-auth-guest]');
    const iconUser = root.querySelector<HTMLElement>('[data-auth-user]');
    let mountedUserId: string | null = null;

    const render = () => {
      const clerk = window.__crystalicaClerk;
      if (!clerk) return;

      const user = clerk.user;
      const signedIn = Boolean(user);
      const variant = root.dataset.variant;

      if (variant === 'icon') {
        if (iconGuest) iconGuest.hidden = signedIn;
        if (iconUser) iconUser.hidden = !signedIn;
      } else {
        if (guest) guest.hidden = signedIn;
        if (userBox) userBox.hidden = !signedIn;

        if (signedIn && user) {
          // Show username on desktop, hide portfolio link on mobile
          if (userName) {
            userName.textContent = user.fullName || user.firstName || user.emailAddresses?.[0]?.emailAddress?.split('@')[0] || 'Utilizator';
          }
          if (portfolioLink) {
            // Show portfolio link only on desktop (expanded navbar), hide on mobile
            portfolioLink.style.display = variant === 'mobile' ? 'none' : '';
          }
          if (logoutBtn) {
            logoutBtn.style.display = variant === 'mobile' ? 'none' : '';
          }
          
          // Don't mount user button, just show name
          if (mountedUserId && avatar) {
            avatar.replaceChildren();
            mountedUserId = null;
          }
        }
      }
    };

    // Wait for Clerk to fully initialize (load() completed) then show controls
    (window.__crystalicaClerkReady || Promise.resolve())
      .then(() => {
        if (loading) loading.hidden = true;
        root.hidden = false;
        render();
      })
      .catch(() => {
        console.error('[Crystalica] Failed to initialize auth controls');
        root.hidden = true;
      });

    const showBusy = (button: HTMLButtonElement, busy: boolean) => {
      button.disabled = busy;
      button.classList.toggle('is-busy', busy);
    };

    const bindOpener = (selector: string, action: 'signIn' | 'signUp') => {
      const button = root.querySelector<HTMLButtonElement>(selector);
      if (!button) return;

      button.addEventListener('click', () => {
        const clerk = window.__crystalicaClerk;
        if (!clerk) return;
        
        showBusy(button, true);
        try {
          if (action === 'signIn') {
            clerk.openSignIn();
          } else {
            clerk.openSignUp();
          }
        } catch (err) {
          const msg = (err as Error)?.message || '';
          if (msg.includes('Ui components') || msg.includes('UI components')) {
            console.log('[Crystalica] UI not ready, retrying...');
            requestAnimationFrame(() => {
              try {
                if (action === 'signIn') clerk.openSignIn();
                else clerk.openSignUp();
              } catch (e) {
                console.error('[Crystalica] Failed to open modal:', e);
              } finally {
                showBusy(button, false);
              }
            });
            return;
          }
          console.error('[Crystalica] Failed to open modal:', err);
        } finally {
          showBusy(button, false);
        }
      });
    };

    bindOpener('[data-auth-sign-in]', 'signIn');
    bindOpener('[data-auth-sign-up]', 'signUp');

    // Bind logout button
    const logoutBtnLocal = root.querySelector<HTMLButtonElement>('[data-auth-logout]');
    if (logoutBtnLocal) {
      logoutBtnLocal.addEventListener('click', () => {
        const clerk = window.__crystalicaClerk;
        if (clerk && clerk.user) {
          showBusy(logoutBtnLocal, true);
          clerk.signOut()
            .catch((err: any) => console.error('[Crystalica] Logout failed:', err))
            .finally(() => showBusy(logoutBtnLocal, false));
        }
      });
    }

    // Bind icon variant buttons
    if (variant === 'icon') {
      const portfolioBtn = root.querySelector<HTMLButtonElement>('[data-auth-portfolio]');
      if (portfolioBtn) {
        portfolioBtn.addEventListener('click', () => {
          window.location.href = '/portofoliu';
        });
      }
      const logoutBtnIcon = root.querySelector<HTMLButtonElement>('[data-auth-logout]');
      if (logoutBtnIcon) {
        logoutBtnIcon.addEventListener('click', () => {
          const clerk = window.__crystalicaClerk;
          if (clerk && clerk.user) {
            showBusy(logoutBtnIcon, true);
            clerk.signOut()
              .catch((err: any) => console.error('[Crystalica] Logout failed:', err))
              .finally(() => showBusy(logoutBtnIcon, false));
          }
        });
      }
      bindOpener('[data-auth-sign-in]', 'signIn');
      bindOpener('[data-auth-sign-up]', 'signUp');
    }

    // Listen for Clerk updates
    waitForClerk().then(() => {
      window.__crystalicaClerk?.addListener(render);
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll<HTMLElement>('[data-auth-controls]').forEach(initAuthControls);
    });
  } else {
    document.querySelectorAll<HTMLElement>('[data-auth-controls]').forEach(initAuthControls);
  }
</script>