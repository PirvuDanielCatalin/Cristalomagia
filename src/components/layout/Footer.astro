---
// Footer.astro - Site footer
---

<footer class="footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">Crystal<span>ica</span></a>
        <p class="footer-desc">
          Enciclopedia ta personală de cristale. Proprietăți energetice, istorii, chakre, zodiac și folosințe practice.
        </p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Navigare site">
        <h4 class="footer-title">Explorează</h4>
        <ul class="footer-links">
          <li><a href="/cristale" class="footer-link">Toate Cristalele</a></li>
          <li><a href="/rss.xml" class="footer-link">Feed RSS</a></li>
        </ul>
      </nav>

      <!-- Connect -->
      <div>
        <h4 class="footer-title">Contact</h4>
        <ul class="footer-links">
          <li><a href="mailto:contact@crystalica.com" class="footer-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="margin-right: 6px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Email
          </a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">© {new Date().getFullYear()} Crystalica. Toate drepturile rezervate.</p>
    </div>
  </div>
</footer>
