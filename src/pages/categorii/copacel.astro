---
// src/pages/categorii/copacel.astro - Copacel category page
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const crystals = await getCollection('crystals');
const categoryCrystals = crystals.filter(c => c.data.category.some(cat => cat.toLowerCase() === 'copacel'));

// Pre-compute category badges for each crystal
const crystalsWithBadges = categoryCrystals.map(crystal => ({
  ...crystal,
  categoryBadges: crystal.data.category.map(cat => ({
    name: cat,
    class: `badge badge-${cat.toLowerCase().replace('ă','a').replace('ș','s').replace('ț','t').replace('î','i').replace('â','a')}`
  }))
}));
---

<BaseLayout title="Copacel — Crystalica">
  <section class="section">
    <div class="container">
      <header class="text-center mb-12 animate-fade-in">
        <nav class="flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-6 justify-center" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[var(--color-text)] transition-colors">Acasă</a>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          <a href="/categorii" class="hover:text-[var(--color-text)] transition-colors">Categorii</a>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          <span class="text-[var(--color-text)] font-medium" aria-current="page">Copacel</span>
        </nav>
        
        <h1 class="font-heading text-4xl lg:text-5xl font-medium tracking-tight mb-4">
          Copacel
        </h1>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          {categoryCrystals.length} cristale în această categorie
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
        {crystalsWithBadges.map((crystal, index) => (
          <article class="card group animate-slide-up" style={`animation-delay: ${index * 50}ms;`} role="listitem">
            <a href={`/cristale/${crystal.data.slug}`} class="block" aria-label={`Vezi detalii despre ${crystal.data.name}`}>
              <div class="aspect-square relative overflow-hidden bg-[var(--color-earth-100)]">
                {crystal.data.image ? (
                  <img src={crystal.data.image} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-[var(--color-crystal-teal)]/10 to-[var(--color-crystal-rose)]/10">
                    <svg width="48" height="48" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-[var(--color-crystal-teal)]/30" aria-hidden="true">
                      <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                )}
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  {crystal.categoryBadges.map(badge => (
                    <span class={badge.class} aria-hidden="true">{badge.name}</span>
                  ))}
                </div>
              </div>

              <div class="p-5">
                <h3 class="font-heading text-lg font-medium mb-2 group-hover:text-[var(--color-crystal-teal)] transition-colors">
                  {crystal.data.name}
                </h3>
                <p class="text-sm text-[var(--color-text-muted)] mb-3 line-clamp-2">
                  {crystal.data.description}
                </p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>