---
// index.astro - Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const crystals = await getCollection('crystals');
// Pick a random crystal for the day (at build time)
const randomIndex = Math.floor(Math.random() * crystals.length);
const crystalOfTheDay = crystals[randomIndex];
---

<BaseLayout title="Crystalica — Enciclopedia ta personală de cristale" description="Descoperă proprietățile energetice, istorii, chakre, zodiac și folosințe practice pentru fiecare cristal.">
  <!-- Minimal Hero -->
  <section class="hero-minimal" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-inner">
        <h1 id="hero-title" class="font-heading text-5xl lg:text-7xl font-medium tracking-tight leading-tight text-[var(--color-zinc-900)]">
          Crystalica
          <span class="block text-[var(--color-text-muted)] text-2xl lg:text-3xl mt-4 font-normal">
            Enciclopedia cristalelor
          </span>
        </h1>
        <p class="text-lg lg:text-xl text-[var(--color-text-muted)] leading-relaxed max-w-2xl mx-auto mt-6 mb-10">
          Proprietăți energetice, istorii, chakre, zodiac și folosințe practice pentru fiecare cristal din colecția ta.
        </p>
        <a href="/cristale" class="btn btn-glow text-base px-8 py-3">
          Explorează Cristalele
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Crystal of the Day -->
  {crystalOfTheDay && (
    <section class="crystal-day-section" aria-labelledby="day-title">
      <div class="container">
        <div class="crystal-day-inner crystal-day-inner-wide">
          <h2 class="crystal-day-label text-center">Cristalul Zilei</h2>
          <div class="crystal-day-card">
            <a href={`/cristale/${crystalOfTheDay.data.slug}`} class="crystal-day-link">
              <div class="crystal-day-image">
                {crystalOfTheDay.data.image ? (
                  <img src={crystalOfTheDay.data.image} alt={crystalOfTheDay.data.name} loading="lazy" />
                ) : (
                  <div class="crystal-day-placeholder">
                    <svg width="48" height="48" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                      <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="crystal-day-info">
                <h2 id="day-title" class="crystal-day-name">{crystalOfTheDay.data.name}</h2>
                <p class="crystal-day-desc">{crystalOfTheDay.data.description}</p>
                <span class="crystal-day-cta">Vezi detalii →</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
